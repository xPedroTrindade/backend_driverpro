PORT=3000

# Supabase (Postgres) — Project Settings > Database > Connection string
# DATABASE_URL: POOLER (Transaction mode, porta 6543) — usada pela API em runtime
DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: Session pooler (porta 5432) — usada só pelo `prisma migrate`
DIRECT_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres"

# Supabase Storage (avatares) — Project Settings > API Keys
# SUPABASE_SECRET_KEY: chave SECRETA (sb_secret_... ou a service_role antiga). Só no servidor, nunca no app.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SECRET_KEY=

# JWT
JWT_SECRET=gere_uma_chave_segura_com_node_-e_"require('crypto').randomBytes(64).toString('hex')"

# SMTP (envio de e-mails) — PENDENTE: ainda é um stub, não envia de verdade.
# Preencher e implementar (nodemailer em src/services/mailer.ts) quando for ativar.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DriverPro <no-reply@driverpro.com>"

# Google Maps (Routes API) — chave do projeto driverPro (Places + Routes ativadas)
GOOGLE_MAPS_API_KEY=
